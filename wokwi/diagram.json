    ["btn_p:2.l", "esp:GND.1", "black", ["h-20", "v-80"]],
    ["btn_k:1.r", "esp:25", "orange", ["h20"]],
    ["btn_k:2.l", "esp:GND.1", "black", ["h-20", "v-120"]],
    ["btn_ok:1.r", "esp:27", "green", ["h20"]],
    ["btn_ok:2.l", "esp:GND.1", "black", ["h-20", "v-160"]]
