# Plant.id API key from https://admin.kindwise.com/
PLANT_ID_API_KEY=your_api_key

# ESP32 controller IP after it joins Wi-Fi (from Serial Monitor)
ESP32_CONTROLLER_URL=http://192.168.1.50

# CAM bridge server (laptop)
PLANTID_SERVER_HOST=0.0.0.0
PLANTID_SERVER_PORT=8080

# 1 = auto POST /dose to ESP32 after Plant.id decision
PLANTID_AUTO_TRIGGER=1

# Still-test camera (laptop pulls /still so Windows firewall cannot block CAM→PC)
ESP32_CAM_STILL_URL=http://192.168.1.6/still
ESP32_CAM_PULL_INTERVAL_S=10

# Supabase Hydroponics project (Project Settings → API)
# Use the service_role key (server only). Never put this on the ESP32.
SUPABASE_URL=https://cinwmlczshhaisqlukad.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET=plant-photos
SUPABASE_TABLE=captures
