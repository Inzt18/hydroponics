# --- Plant.id ---
PLANT_ID_API_KEY=your_api_key

# --- ESP32 pump controller ---
ESP32_CONTROLLER_URL=http://192.168.1.50
ESP32_CAM_STILL_URL=
ESP32_CAM_PULL_INTERVAL_S=10

# --- Dose tuning ---
PLANTID_AUTO_TRIGGER=1
DOSE_MS_BASE=3000
DOSE_MS_MAX=12000
DOSE_SEVERITY_MIN=35

# --- Server ---
PLANTID_SERVER_HOST=0.0.0.0
PLANTID_SERVER_PORT=8080

# --- Supabase ---
# Set SUPABASE_ENABLED=0 to skip Supabase entirely and keep local-only storage.
SUPABASE_ENABLED=1
SUPABASE_URL=https://cinwmlczshhaisqlukad.supabase.co
# Service role key: server-side only, NEVER put this in ESP32 firmware or commit it.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET=plant-photos
SUPABASE_TABLE=captures

# Dashboard weather (Open-Meteo, no API key). Change lat/lon to your farm.
WEATHER_LAT=14.5995
WEATHER_LON=120.9842
WEATHER_PLACE=Manila
WEATHER_TZ=Asia/Manila
